  <script>if ("serviceWorker" in navigator) navigator.serviceWorker.register("/sw.js").catch(() => {});</script>
    <script>/* phone: floating button back to the mobile page (only on the tailscale hostname) */
  if (location.hostname.endsWith(".ts.net")) addEventListener("DOMContentLoaded", function () {
    var b = document.createElement("button"); b.textContent = "← หน้ามือถือ";
    b.style.cssText = "position:fixed;right:12px;bottom:calc(96px + env(safe-area-inset-bottom));z-index:99999;padding:10px 14px;border-radius:999px;border:0;background:#60a5fa;color:#031022;font:600 14px sans-serif;box-shadow:0 4px 16px #0008";
    b.onclick = function () { try { localStorage.removeItem("maw-desktop-ui"); } catch (e) {} location.href = "/m.html"; };
    document.body.appendChild(b);
  });</script>
