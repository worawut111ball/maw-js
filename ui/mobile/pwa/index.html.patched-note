    <script>/* phone: the desktop UI cannot run on the tailscale hostname → send phones/installed app to the mobile page */ var wantDesktop; try { wantDesktop = localStorage.getItem("maw-desktop-ui") === "1"; } catch (e) {} if (!wantDesktop && !/[?&]host=/.test(location.search) && (location.hostname.endsWith(".ts.net") || matchMedia("(display-mode: standalone)").matches)) location.replace("/m.html");</script>
