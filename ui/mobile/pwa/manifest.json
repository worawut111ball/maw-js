{
  "name": "maw — agents",
  "short_name": "maw",
  "id": "/m.html",
  "start_url": "/m.html",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#020208",
  "theme_color": "#020208",
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/favicon.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    }
  ],
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "files",
          "accept": [
            "image/*",
            "video/*",
            "application/pdf",
            "text/*",
            "*/*"
          ]
        }
      ]
    }
  }
}