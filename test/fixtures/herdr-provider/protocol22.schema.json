            },
            "agent_session": {
              "anyOf": [
                {
                  "$ref": "#/schemas/success_response/$defs/AgentSessionInfo"
                },
                {
                  "type": "null"
                }
              ]
            },
            "agent_status": {
              "$ref": "#/schemas/success_response/$defs/AgentStatus"
            },
            "cwd": {
              "type": [
                "string",
                "null"
              ]
            },
            "display_agent": {
              "type": [
                "string",
                "null"
              ]
            },
            "focused": {
              "type": "boolean"
            },
            "foreground_cwd": {
              "type": [
                "string",
                "null"
              ]
            },
            "label": {
              "type": [
                "string",
                "null"
              ]
            },
            "pane_id": {
              "type": "string"
            },
            "restore_error": {
              "type": [
                "string",
                "null"
              ]
            },
            "revision": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "scroll": {
              "anyOf": [
                {
                  "$ref": "#/schemas/success_response/$defs/PaneScrollInfo"
                },
                {
                  "type": "null"
                }
              ]
            },
            "state_labels": {
              "additionalProperties": {
                "type": "string"
              },
              "type": "object"
            },
            "tab_id": {
              "type": "string"
            },
            "terminal_id": {
              "type": "string"
            },
            "terminal_title": {
              "type": [
                "string",
                "null"
              ]
            },
            "terminal_title_stripped": {
              "type": [
                "string",
                "null"
              ]
            },
            "title": {
              "type": [
                "string",
                "null"
              ]
            },
            "tokens": {
              "additionalProperties": {
                "type": "string"
              },
              "maxProperties": 32,
              "propertyNames": {
                "pattern": "^[A-Za-z0-9_-]{1,32}$"
              },
              "type": "object"
            },
            "workspace_id": {
              "type": "string"
            }
          },
          "required": [
            "pane_id",
            "terminal_id",
            "workspace_id",
            "tab_id",
            "focused",
            "agent_status",
            "revision"
          ],
          "type": "object"
        },
        "PaneLayoutSnapshot": {
          "properties": {
            "area": {
              "$ref": "#/schemas/success_response/$defs/PaneLayoutRect"
