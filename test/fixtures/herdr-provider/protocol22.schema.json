            "panes": {
              "items": {
                "$ref": "#/schemas/success_response/$defs/PaneLayoutPane"
              },
              "type": "array"
            },
            "splits": {
              "items": {
                "$ref": "#/schemas/success_response/$defs/PaneLayoutSplit"
              },
              "type": "array"
